{
  "name": "baby-log",
  "version": "0.0.0",
  "scripts": {
    "start": "ng serve",
    "start:with-emulators": "concurrently -k -n firebase,angular \"npm run firebase:emulators\" \"wait-on http://127.0.0.1:4000 && npm run start\"",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "firebase:emulators": "firebase emulators:start --import ./firebase-emulator-data --export-on-exit"
  },
  "private": true,
  "dependencies": {
    "@angular-architects/ngrx-toolkit": "^21.0.1",
    "@angular/animations": "^21.2.22",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.22",
    "@angular/compiler": "^21.2.22",
    "@angular/core": "^21.2.22",
    "@angular/fire": "21.0.0-rc.0",
    "@angular/forms": "^21.2.22",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.2.22",
    "@angular/platform-browser-dynamic": "^21.2.22",
    "@angular/router": "^21.2.22",
    "@ngrx/signals": "^21.1.1",
    "bootstrap": "^5.3.2",
    "firebase": "^12.4.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.22",
    "@angular/cli": "^21.2.22",
    "@angular/compiler-cli": "^21.2.22",
    "concurrently": "^9.2.1",
    "typescript": "~5.9.3",
    "wait-on": "^9.0.10"
  }
}
